NODE_ENV=development

PORT=3000

REDIS_HOST=localhost
REDIS_PORT=6380

# CEP cache TTL in seconds (default: 24 hours)
CEP_CACHE_TTL=86400

# Timeout for each external provider request in milliseconds
CEP_PROVIDER_TIMEOUT_MS=3000

VIACEP_BASE_URL=https://viacep.com.br
BRASIL_API_BASE_URL=https://brasilapi.com.br

RATE_LIMIT_CAPACITY=100
RATE_LIMIT_REFILL_RATE=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_KEY_PREFIX=ratelimit
RATE_LIMIT_TTL_SECONDS=120
